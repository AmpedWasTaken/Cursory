{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/hooks/pre-tool-use.js\"",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/hooks/session-end.js\"",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/hooks/post-tool-use.js\"",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/dist/hooks/pre-compact.js\"",
        "timeout": 10
      }
    ]
  }
}
